{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.php" },
    { "source": "/index.html", "destination": "/api/index.php" },
    { "source": "/track.php", "destination": "/api/track.php" },
    { "source": "/ads/track.php", "destination": "/api/track.php" }
  ]
}
