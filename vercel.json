{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/index\\.php", "dest": "/api/index.php" },
    { "src": "/index\\.html", "dest": "/api/index.php" },
    { "src": "/track\\.php", "dest": "/api/track.php" },
    { "src": "/ads/track\\.php", "dest": "/api/track.php" },
    { "src": "/health\\.php", "dest": "/api/health.php" },
    { "handle": "filesystem" }
  ]
}
